# Copy to .env and fill in. Never commit .env.
# With Docker (docker compose up), DATABASE_HOST and REDIS_HOST are set for
# you; the other values below are still read from this file.

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=security_alerts
# Apply pending migrations when the app starts (Docker sets this to true).
DATABASE_RUN_MIGRATIONS=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=?*48
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Behind a reverse proxy: number of proxy hops to trust for the client IP (e.g. 1).
# Leave empty when clients connect directly.
TRUST_PROXY=
# Browser origins allowed to call the API, comma-separated. Empty = no CORS.
CORS_ORIGINS=

# Notifications (each channel is enabled when its settings are present)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# Telegram: token from @BotFather, chat id from getUpdates (see docs/TELEGRAM.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=security-alerts@example.com
ALERT_EMAIL_TO=

# Firewall / IP filter
# How long an IP stays blocked after a rule escalates a high or critical
# alert from it. 0 turns automatic blocking off.
FIREWALL_AUTO_BLOCK_MINUTES=60
# IPs or CIDR ranges that are never blocked, comma-separated
# (e.g. your office or the servers of integrated apps).
FIREWALL_ALLOWLIST=

# Docker host ports (change one if it's already taken on your machine)
API_HOST_PORT=3000
BANK_HOST_PORT=4000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Lotus Demo Bank's API key. `npm run demo:setup` fills this in for you.
# To do it by hand instead (Docker stack running):
#   1. Create an admin, if you haven't yet:
#        docker compose exec api node dist/scripts/seed-admin.js --email admin@lotus.demo
#   2. Log in and copy "accessToken" from the response:
#        curl -s -X POST localhost:3000/auth/login -H 'Content-Type: application/json' \
#          -d '{"email":"admin@lotus.demo","password":"<your admin password>"}'
#   3. Register the bank as a source and copy "apiKey" (sa_...). It is shown only once.
#      If the name already exists, use another one, e.g. lotus-demo-bank-2.
#        curl -s -X POST localhost:3000/sources -H "Authorization: Bearer <accessToken>" \
#          -H 'Content-Type: application/json' -d '{"name":"lotus-demo-bank"}'
#   4. Paste it below, then restart the bank so it picks up the key:
#        docker compose up -d bank-demo
BANK_API_KEY=

# Telegram: token from @BotFather, chat id from getUpdates (see docs/TELEGRAM.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
