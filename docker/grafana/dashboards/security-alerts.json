          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT network AS \"Network\",\n       origin::text AS \"Origin\",\n       reason AS \"Reason\",\n       \"createdAt\" AS \"Blocked at\",\n       \"expiresAt\" AS \"Expires\"\nFROM blocked_ips\nWHERE \"expiresAt\" IS NULL OR \"expiresAt\" > now()\nORDER BY \"createdAt\" DESC\nLIMIT 50"
