    {
      "id": 9,
      "type": "table",
      "title": "Top attacking IPs",
      "description": "IPs that triggered the most alerts in the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "security-alerts-db"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "security-alerts-db"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT \"ipAddress\" AS \"IP\",\n       count(*) AS \"Alerts\",\n       count(*) FILTER (WHERE severity IN ('high','critical')) AS \"High+\",\n       max(\"createdAt\") AS \"Last seen\",\n       EXISTS (SELECT 1 FROM blocked_ips b\n               WHERE b.network = alerts.\"ipAddress\" || CASE WHEN alerts.\"ipAddress\" LIKE '%:%' THEN '/128' ELSE '/32' END\n                 AND (b.\"expiresAt\" IS NULL OR b.\"expiresAt\" > now())) AS \"Blocked\"\nFROM alerts\nWHERE \"ipAddress\" IS NOT NULL AND $__timeFilter(\"createdAt\") AND \"sourceId\"::text IN ($source) AND severity::text IN ($severity)\nGROUP BY \"ipAddress\"\nORDER BY 2 DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Blocked"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "color": "red",
                        "index": 0,
                        "text": "⛔ blocked"
                      },
                      "false": {
                        "color": "transparent",
                        "index": 1,
                        "text": "-"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Blocked"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alerts"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "High+"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
