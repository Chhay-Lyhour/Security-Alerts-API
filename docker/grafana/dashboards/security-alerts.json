          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT a.\"createdAt\" AS \"Time\",\n       a.severity::text AS \"Severity\",\n       a.type AS \"Type\",\n       a.title AS \"Title\",\n       a.\"ipAddress\" AS \"IP\",\n       s.name AS \"Source\",\n       a.status::text AS \"Status\"\nFROM alerts a\nLEFT JOIN sources s ON s.id = a.\"sourceId\"\nWHERE $__timeFilter(a.\"createdAt\") AND a.\"sourceId\"::text IN ($source) AND a.severity::text IN ($severity)\nORDER BY a.\"createdAt\" DESC\nLIMIT 100"
        }
