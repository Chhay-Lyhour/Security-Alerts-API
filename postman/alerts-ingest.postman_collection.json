{
  "info": {
    "_postman_id": "19e4d125-0ec8-47c4-a3c6-3192453b7730",
    "name": "Security Alerts API - Alerts & Ingest",
    "description": "Role 2: sources, alert ingest, filters, status changes.\n\nRun the folders in order (or use Run collection). Set adminEmail/adminPassword to the admin you created with `npm run seed:admin`.\n\nNote: /auth/login allows 5 requests per minute and /auth/register 3 per minute.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fresh time range for the 'last 24 hours' filter.",
          "pm.collectionVariables.set('now', new Date(Date.now() + 60000).toISOString());",
          "pm.collectionVariables.set('from24h', new Date(Date.now() - 86400000).toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "Log in as the admin (made with `npm run seed:admin`) and register an analyst. Tokens are saved into collection variables.",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register analyst",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates an analyst account. Returns 409 if it already exists; then just run \"Login as analyst\".",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{analystEmail}}\",\n  \"password\": \"{{analystPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created, or 409 if the analyst already exists', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('analystToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as analyst",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{analystEmail}}\",\n  \"password\": \"{{analystPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('analystToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Sources (admin)",
      "description": "Register the external system that will send alerts. The API key is returned once and saved into {{apiKey}}.",
      "item": [
        {
          "name": "Create source",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sources"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"web-server-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns an sa_ key once', () => pm.expect(body.apiKey).to.match(/^sa_/));",
                  "pm.test('never returns the hash', () => pm.expect(body).to.not.have.property('apiKeyHash'));",
                  "pm.collectionVariables.set('apiKey', body.apiKey);",
                  "pm.collectionVariables.set('sourceId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List sources",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sources"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('no keys in the list', () => pm.response.json().forEach(s => pm.expect(s).to.not.have.property('apiKey')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Ingest (API key)",
      "description": "What an external system sends. Uses the x-api-key header, no JWT.",
      "item": [
        {
          "name": "Ingest alert (high)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Failed login for bob\",\n  \"severity\": \"high\",\n  \"type\": \"failed_login\",\n  \"ipAddress\": \"203.0.113.7\",\n  \"payload\": {\n    \"username\": \"bob\",\n    \"attempts\": 3\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('saved as open', () => pm.expect(body.status).to.eql('open'));",
                  "pm.collectionVariables.set('alertId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ingest alert (low)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Login from a new IP\",\n  \"severity\": \"low\",\n  \"type\": \"new_ip\",\n  \"ipAddress\": \"198.51.100.20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ingest alert (critical, no IP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Admin role granted outside change window\",\n  \"severity\": \"critical\",\n  \"type\": \"permission_change\",\n  \"payload\": {\n    \"user\": \"eve\",\n    \"role\": \"admin\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Query (analyst)",
      "description": "List, filter and page through alerts. Response shape: { data, total, page, limit }.",
      "item": [
        {
          "name": "List all alerts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has data, total, page', () => { pm.expect(body.data).to.be.an('array'); pm.expect(body.total).to.be.a('number'); pm.expect(body.page).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: high + open",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts?severity=high&status=open",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ],
              "query": [
                {
                  "key": "severity",
                  "value": "high"
                },
                {
                  "key": "status",
                  "value": "open"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('only high, open alerts', () => pm.response.json().data.forEach(a => { pm.expect(a.severity).to.eql('high'); pm.expect(a.status).to.eql('open'); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: by type",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts?type=failed_login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "failed_login"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('only failed_login', () => pm.response.json().data.forEach(a => pm.expect(a.type).to.eql('failed_login')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: by source and IP",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts?sourceId={{sourceId}}&ipAddress=203.0.113.7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ],
              "query": [
                {
                  "key": "sourceId",
                  "value": "{{sourceId}}"
                },
                {
                  "key": "ipAddress",
                  "value": "203.0.113.7"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('only this source and IP', () => pm.response.json().data.forEach(a => { pm.expect(a.sourceId).to.eql(pm.collectionVariables.get('sourceId')); pm.expect(a.ipAddress).to.eql('203.0.113.7'); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: last 24 hours",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts?from={{from24h}}&to={{now}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "{{from24h}}"
                },
                {
                  "key": "to",
                  "value": "{{now}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagination: page 1, 2 per page",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts?page=1&limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('at most 2 rows', () => pm.expect(body.data.length).to.be.at.most(2));",
                  "pm.test('limit echoed', () => pm.expect(body.limit).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get alert by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts/{{alertId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts",
                "{{alertId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('right alert', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('alertId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Status (analyst)",
      "description": "Status only moves forward: open -> acknowledged -> resolved.",
      "item": [
        {
          "name": "Acknowledge alert",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts/{{alertId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts",
                "{{alertId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"acknowledged\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('now acknowledged', () => pm.expect(pm.response.json().status).to.eql('acknowledged'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve alert",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alerts/{{alertId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alerts",
                "{{alertId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('now resolved', () => pm.expect(pm.response.json().status).to.eql('resolved'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
